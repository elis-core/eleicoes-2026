{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "elis-atlas-customer-service",
  "main": "index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "atlas-api.electoralintegrity.org", "custom_domain": true}
  ],
  "vars": {
    "ATLAS_URL": "https://atlas-brazil-2026.electoralintegrity.org/",
    "ALLOWED_ORIGINS": "https://atlas-brazil-2026.electoralintegrity.org,https://elis-core.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [
    {"name": "CHAT_LIMIT", "namespace_id": "562710501", "simple": {"limit": 10, "period": 60}}
  ]
}
